{
  "name": "GhostDrive",
  "description": "Client de synchronisation Windows vers backends de stockage prives (WebDAV, MooseFS, S3...). Equivalent OneDrive open-source avec placeholders Files On-Demand, cache local et architecture plugin.",
  "version": "0.6.0",
  "initialized_at": "2026-04-15T00:00:00Z",
  "initialized_from": "workshop",
  "stack": {
    "backend": {
      "language": "go",
      "version": "1.24.0",
      "framework": "wails-backend",
      "entry": "./cmd/ghostdrive",
      "architecture": "plugin-interface"
    },
    "frontend": {
      "language": "typescript",
      "framework": "wails+react",
      "path": "frontend/"
    },
    "mobile": null,
    "firmware": null,
    "database": null,
    "plugins": {
      "interface": "plugins/plugin.go",
      "v1": [
        "webdav",
        "moosefs"
      ],
      "pattern": "go-interface-compiled"
    },
    "plugin": {
      "platform": "GhostDrive StorageBackend (Go, gRPC)"
    }
  },
  "platform": {
    "primary": "windows",
    "secondary": [
      "linux"
    ],
    "windows_api": [
      "cloud-filter-api",
      "winfsp"
    ],
    "distribution": "binary-releases"
  },
  "infrastructure": {
    "cicd": "github-actions",
    "targets": [
      {
        "os": "windows",
        "arch": "amd64",
        "suffix": "windows-amd64.exe"
      }
    ],
    "versioning": "semantic",
    "version_sources": [
      "config.json",
      "frontend/package.json",
      "git-tag"
    ],
    "environments": [
      {
        "name": "QUALIF",
        "order": 1,
        "publish": {
          "mode": "promote",
          "target": "build/qualif/{X.Y.Z}/"
        },
        "deploy": {
          "mechanism": "binary-releases"
        }
      },
      {
        "name": "PROD",
        "order": 2,
        "publish": {
          "mode": "rebuild-ci",
          "trigger": "git-tag",
          "pipeline": ".github/workflows/build.yml"
        },
        "deploy": {
          "mechanism": "binary-releases"
        }
      }
    ]
  },
  "testing": {
    "backend": [
      "go-test",
      "testify"
    ],
    "frontend": [
      "vitest"
    ],
    "e2e": [],
    "integration": [
      "webdav-in-memory"
    ],
    "coverage_threshold": 70,
    "regression_at_qa": "gated",
    "full_regression_at": "qualif",
    "coverage_min": 70,
    "lot_max_tests": 50
  },
  "security": {
    "concerns": [
      "local-file-access",
      "backend-credentials",
      "private-storage"
    ]
  },
  "versioning": {
    "roadmap": {
      "v1": "Sync + placeholders Files On-Demand + cache local (WebDAV + MooseFS)",
      "v2": "Multi-client synchronise sur le meme backend",
      "v3": "Chiffrement cote client + versioning"
    }
  },
  "conventions": {
    "branches": {
      "feature": "feat/<name>",
      "bugfix": "bug/<name>",
      "hotfix": "hotfix/<name>"
    },
    "commits": "conventional-commits",
    "issues": {
      "epics": "parent-issues-with-checklist",
      "milestones": [
        "V1",
        "V2",
        "V3"
      ],
      "workflow": "open -> in-progress (branch linked) -> PR -> done"
    }
  },
  "team_name": "ghostdrive-team",
  "org": "CCoupel",
  "project": "GhostDrive",
  "commands": {
    "build": "wails build",
    "test": "go test ./... -v -cover",
    "lint": "golangci-lint run",
    "audit": "govulncheck ./...",
    "typecheck": "cd frontend && npm run typecheck",
    "coverage": "go test -cover ./...",
    "test_fast": "go test -short ./...",
    "test_targeted": "go test {TARGETS}",
    "ci": "scripts/ci.sh"
  },
  "template_version": {
    "tag": "v3.27.0",
    "commit": "2ca467df6ab3786c4e6949c1bce43f25c869a5bf"
  },
  "docs": {
